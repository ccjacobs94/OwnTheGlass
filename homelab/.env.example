# Copy to homelab/.env (gitignored) and fill in your values.

# Treat the ntfy topic like a password: anyone who knows it can read/publish on public ntfy.sh.
# Generate one with e.g.:  python -c "import secrets; print('otg-' + secrets.token_urlsafe(18))"
NTFY_TOPIC=
# Optional: access token if you use a reserved topic / self-hosted ntfy with auth
NTFY_TOKEN=

# Interface the dashboard binds to. 127.0.0.1 = this machine only.
# Set to your LAN IP to allow other devices on your home network.
BIND_ADDRESS=127.0.0.1
