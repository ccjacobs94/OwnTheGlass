---
import Layout from '../layouts/Layout.astro';

export const prerender = false;

const url = new URL(Astro.request.url);
const status = url.searchParams.get('status') || 'success';
const modelName = url.searchParams.get('model') || 'your TV model';
---

<Layout title="Unsubscribe Confirmation — OwnTheGlass">
  <div class="max-w-md mx-auto px-4 py-20 text-center">
    <div class="bg-[#121622] border border-slate-800 rounded-2xl p-8 shadow-2xl">
      {status === 'success' ? (
        <div>
          <div class="w-12 h-12 rounded-full bg-emerald-950/80 border border-emerald-500/40 text-emerald-400 flex items-center justify-center text-2xl mx-auto mb-4">
            ✓
          </div>
          <h1 class="text-xl font-bold text-white mb-2">Unsubscribed Successfully</h1>
          <p class="text-xs text-slate-400 leading-relaxed mb-6">
            You will no longer receive firmware alerts for <strong class="text-slate-200">{modelName}</strong>.
          </p>
          <a
            href="/"
            class="inline-block w-full bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-xs py-2.5 px-4 rounded-lg transition border border-slate-700"
          >
            Return to TV Catalog
          </a>
        </div>
      ) : (
        <div>
          <div class="w-12 h-12 rounded-full bg-rose-950/80 border border-rose-500/40 text-rose-400 flex items-center justify-center text-2xl mx-auto mb-4">
            ✕
          </div>
          <h1 class="text-xl font-bold text-white mb-2">Unsubscribe Failed</h1>
          <p class="text-xs text-slate-400 leading-relaxed mb-6">
            This unsubscribe link is invalid or has already been used.
          </p>
          <a
            href="/"
            class="inline-block w-full bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-xs py-2.5 px-4 rounded-lg transition border border-slate-700"
          >
            Return to TV Catalog
          </a>
        </div>
      )}
    </div>
  </div>
</Layout>
