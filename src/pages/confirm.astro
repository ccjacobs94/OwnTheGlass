---
import Layout from '../layouts/Layout.astro';
import { confirmSubscription } from '../lib/db';

export const prerender = false;

const url = new URL(Astro.request.url);
const rawToken = url.searchParams.get('token');
const token = rawToken ? rawToken.trim() : null;
let status = url.searchParams.get('status');
let modelName = url.searchParams.get('model') || '';

// Handle direct navigation to /confirm?token=xyz
if (rawToken !== null && !status) {
  if (!token) {
    status = 'missing_token';
  } else {
    const env = (Astro.locals as any).runtime?.env || {};
    const db = env.DB;
    if (!db) {
      status = 'error';
    } else {
      try {
        const result = await confirmSubscription(db, token);
        if (result.status === 'confirmed') {
          status = 'success';
          if (result.modelName) modelName = result.modelName;
        } else if (result.status === 'already_confirmed') {
          status = 'already_confirmed';
          if (result.modelName) modelName = result.modelName;
        } else if (result.status === 'missing_token') {
          status = 'missing_token';
        } else {
          status = 'invalid_token';
        }
      } catch {
        status = 'error';
      }
    }
  }
}

if (!status) {
  status = 'missing_token';
}

if (!modelName) {
  modelName = 'your TV model';
} else if (modelName.length > 150) {
  modelName = modelName.slice(0, 150) + '…';
}

const rawMessage = url.searchParams.get('message');
let errorMessage = 'An unexpected error occurred while verifying your subscription. Please try again later.';
if (rawMessage && rawMessage.trim()) {
  const cleanMsg = rawMessage.trim();
  errorMessage = cleanMsg.length > 200 ? cleanMsg.slice(0, 200) + '…' : cleanMsg;
}
---

<Layout title="Subscription Confirmation — OwnTheGlass">
  <div class="max-w-md mx-auto px-4 py-20 text-center">
    <div class="bg-[#121622] border border-slate-800 rounded-2xl p-8 shadow-2xl">
      {status === 'success' ? (
        <div>
          <div class="w-12 h-12 rounded-full bg-emerald-950/80 border border-emerald-500/40 text-emerald-400 flex items-center justify-center text-2xl mx-auto mb-4">
            ✓
          </div>
          <h1 class="text-xl font-bold text-white mb-2">Subscription Confirmed!</h1>
          <p class="text-xs text-slate-400 leading-relaxed mb-6">
            You are now confirmed to receive instant email alerts whenever new official firmware releases for <strong class="text-slate-200">{modelName}</strong>.
          </p>
          <a
            href="/"
            class="inline-block w-full bg-emerald-500 hover:bg-emerald-400 text-black font-bold text-xs py-2.5 px-4 rounded-lg transition shadow-lg shadow-emerald-500/20"
          >
            Return to TV Catalog
          </a>
        </div>
      ) : status === 'already_confirmed' ? (
        <div>
          <div class="w-12 h-12 rounded-full bg-emerald-950/80 border border-emerald-500/40 text-emerald-400 flex items-center justify-center text-2xl mx-auto mb-4">
            ✓
          </div>
          <h1 class="text-xl font-bold text-white mb-2">Already Confirmed</h1>
          <p class="text-xs text-slate-400 leading-relaxed mb-6">
            Your subscription for <strong class="text-slate-200">{modelName}</strong> has already been confirmed. You will receive alerts when new firmware is available.
          </p>
          <a
            href="/"
            class="inline-block w-full bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-xs py-2.5 px-4 rounded-lg transition border border-slate-700"
          >
            Return to TV Catalog
          </a>
        </div>
      ) : status === 'invalid_token' ? (
        <div>
          <div class="w-12 h-12 rounded-full bg-rose-950/80 border border-rose-500/40 text-rose-400 flex items-center justify-center text-2xl mx-auto mb-4">
            ✕
          </div>
          <h1 class="text-xl font-bold text-white mb-2">Invalid or Expired Link</h1>
          <p class="text-xs text-slate-400 leading-relaxed mb-6">
            This confirmation link is invalid or has expired. If you would like to receive firmware alerts, please subscribe again.
          </p>
          <a
            href="/"
            class="inline-block w-full bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-xs py-2.5 px-4 rounded-lg transition border border-slate-700"
          >
            Return to TV Catalog
          </a>
        </div>
      ) : status === 'missing_token' ? (
        <div>
          <div class="w-12 h-12 rounded-full bg-amber-950/80 border border-amber-500/40 text-amber-400 flex items-center justify-center text-2xl mx-auto mb-4">
            ⚠
          </div>
          <h1 class="text-xl font-bold text-white mb-2">Missing Confirmation Token</h1>
          <p class="text-xs text-slate-400 leading-relaxed mb-6">
            No verification token was found in your link. Please use the verification link sent to your email address.
          </p>
          <a
            href="/"
            class="inline-block w-full bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-xs py-2.5 px-4 rounded-lg transition border border-slate-700"
          >
            Return to TV Catalog
          </a>
        </div>
      ) : (
        <div>
          <div class="w-12 h-12 rounded-full bg-rose-950/80 border border-rose-500/40 text-rose-400 flex items-center justify-center text-2xl mx-auto mb-4">
            ✕
          </div>
          <h1 class="text-xl font-bold text-white mb-2">Verification Error</h1>
          <p class="text-xs text-slate-400 leading-relaxed mb-6">
            {errorMessage}
          </p>
          <a
            href="/"
            class="inline-block w-full bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-xs py-2.5 px-4 rounded-lg transition border border-slate-700"
          >
            Return to TV Catalog
          </a>
        </div>
      )}
    </div>
  </div>
</Layout>
