# OwnTheGlass Environment Configuration

# Resend API Key for Transactional Firmware Update Emails
# Get a free key (3,000 emails/month free) at https://resend.com
RESEND_API_KEY="re_123456789"

# Email Sender Address
EMAIL_FROM="OwnTheGlass <updates@owntheglass.com>"

# App Public URL (used in email links)
APP_URL="https://owntheglass.com"

# Cloudflare Turnstile Bot Protection (Free at https://dash.cloudflare.com/?to=/:account/turnstile)
# REQUIRED in production: if TURNSTILE_SECRET_KEY is missing, /api/subscribe and /api/models/add
# reject all requests (fail closed). Verification is only bypassed on localhost/127.0.0.1.
PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# REQUIRED to enable /api/cron/check. If unset, the endpoint returns 503 (fail closed).
# Callers must send:  Authorization: Bearer <CRON_SECRET>   (the ?key= query param is no longer accepted)
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=""
