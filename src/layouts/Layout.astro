---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'OwnTheGlass — Keep Your TV Private, Offline & Up to Date',
  description = 'Track official TV firmware updates, download direct from manufacturer CDNs, and flash safely via USB without connecting your TV to the internet.',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🛡️</text></svg>" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <!-- Cloudflare Turnstile script -->
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
  </head>
  <body class="bg-[#090A0F] text-slate-200 antialiased selection:bg-emerald-500 selection:text-black">
    <!-- Top Announcement Bar -->
    <div class="bg-gradient-to-r from-emerald-950 via-cyan-950 to-slate-900 border-b border-emerald-800/40 px-4 py-2 text-xs text-center text-emerald-200 font-medium flex items-center justify-center gap-2">
      <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>Keep your TV air-gapped from Wi-Fi & surveillance telemetry. Flash updates safely via USB.</span>
      <a href="/guide" class="underline hover:text-emerald-100 font-semibold ml-1">Follow the Guide →</a>
    </div>

    <!-- Header Navigation -->
    <header class="sticky top-0 z-40 bg-[#090A0F]/80 backdrop-blur-md border-b border-slate-800/60">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-500 to-cyan-600 p-[1px] shadow-lg shadow-emerald-500/20 group-hover:shadow-emerald-500/40 transition-all">
            <div class="w-full h-full bg-[#090A0F] rounded-[11px] flex items-center justify-center text-xl">
              🛡️
            </div>
          </div>
          <div>
            <div class="text-lg font-black tracking-tight text-white flex items-center gap-1.5">
              OwnTheGlass
              <span class="text-[10px] uppercase font-bold tracking-wider px-1.5 py-0.5 rounded bg-emerald-950 border border-emerald-500/30 text-emerald-400">
                Air-Gap
              </span>
            </div>
            <p class="text-[11px] text-slate-400 font-medium">You paid for the panel. Own the glass.</p>
          </div>
        </a>

        <!-- Navigation Links -->
        <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-300">
          <a href="/" class="hover:text-emerald-400 transition-colors">TV Catalog</a>
          <a href="/guide" class="hover:text-emerald-400 transition-colors flex items-center gap-1.5">
            <span>Offline USB Guide</span>
            <span class="text-[10px] px-1.5 py-0.2 rounded bg-cyan-950 text-cyan-400 border border-cyan-500/30 font-semibold">Interactive</span>
          </a>
          <a href="/#manifesto" class="hover:text-emerald-400 transition-colors">Why Air-Gap?</a>
        </nav>

        <!-- Actions -->
        <div class="flex items-center gap-3">
          <button
            id="open-add-model-btn"
            class="px-3.5 py-1.5 text-xs font-semibold rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition flex items-center gap-1.5 cursor-pointer"
          >
            <span class="text-emerald-400 font-bold">+</span>
            <span>Add TV Model</span>
          </button>
          <a
            href="https://github.com"
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800/80 transition"
            title="GitHub Repository"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="min-h-[calc(100vh-16rem)]">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-800/80 bg-[#06070B] mt-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <div class="md:col-span-2">
            <div class="flex items-center gap-2 mb-3">
              <span class="text-2xl">🛡️</span>
              <span class="text-lg font-black text-white">OwnTheGlass</span>
            </div>
            <p class="text-sm text-slate-400 max-w-md leading-relaxed mb-4">
              An open platform empowering TV buyers to reclaim their hardware privacy. Keep your display disconnected from local network scanning and telemetry, while receiving timely alerts and direct links to official USB firmware updates.
            </p>
            <div class="text-xs text-slate-500">
              Inspired by investigations from <a href="https://www.youtube.com/watch?v=6IFVTcM28KA&t=3932s" target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-emerald-400 underline">Gamers Nexus ("216,000,000 Spy TVs")</a> and the right-to-repair community.
            </div>
          </div>

          <div>
            <h4 class="text-xs uppercase font-bold tracking-wider text-slate-300 mb-3">Resources</h4>
            <ul class="space-y-2 text-sm text-slate-400">
              <li><a href="/" class="hover:text-emerald-400 transition">TV Catalog & Search</a></li>
              <li><a href="/guide" class="hover:text-emerald-400 transition">Interactive USB Flashing Guide</a></li>
              <li><a href="/#manifesto" class="hover:text-emerald-400 transition">The Air-Gap Manifesto</a></li>
              <li><a href="https://github.com" target="_blank" class="hover:text-emerald-400 transition">Open Source GitHub</a></li>
            </ul>
          </div>

          <div>
            <h4 class="text-xs uppercase font-bold tracking-wider text-slate-300 mb-3">Security & Source</h4>
            <ul class="space-y-2 text-sm text-slate-400">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                <span>Official Manufacturer CDNs</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                <span>Zero TV Network Connection</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
                <span>1-Click Unsubscribe Guarantee</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
                <span>Edge-Powered by Cloudflare</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="border-t border-slate-800/60 mt-10 pt-6 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
          <p>© {new Date().getFullYear()} OwnTheGlass. Not affiliated with or endorsed by LG Electronics, TCL, Vizio, or Samsung. All trademarks belong to their respective owners.</p>
          <div class="flex items-center gap-4">
            <span>Built with Astro & Cloudflare Pages</span>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
