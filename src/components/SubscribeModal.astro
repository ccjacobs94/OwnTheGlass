---
// SubscribeModal.astro
---

<div id="subscribe-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm hidden">
  <div class="bg-[#121622] border border-slate-700/80 rounded-2xl max-w-md w-full p-6 shadow-2xl relative text-left">
    <!-- Close Button -->
    <button
      id="close-subscribe-modal"
      class="absolute top-4 right-4 text-slate-400 hover:text-white p-1 rounded-lg hover:bg-slate-800 transition cursor-pointer"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Modal Header -->
    <div class="flex items-center gap-3 mb-4">
      <div class="w-10 h-10 rounded-xl bg-emerald-950/80 border border-emerald-500/30 flex items-center justify-center text-xl">
        🔔
      </div>
      <div>
        <h3 class="text-lg font-bold text-white tracking-tight">Get Firmware Alerts</h3>
        <p class="text-xs text-slate-400">Zero spam. Only when new firmware drops.</p>
      </div>
    </div>

    <!-- Selected Model Label -->
    <div class="bg-[#0A0D14] border border-slate-800 rounded-lg p-3 mb-5">
      <div class="text-[11px] text-slate-500 uppercase tracking-wider font-semibold">Subscribing for:</div>
      <div id="modal-model-name" class="text-sm font-bold text-emerald-400 mt-0.5">Select a TV Model</div>
    </div>

    <!-- Form -->
    <form id="subscribe-form" class="space-y-4">
      <input type="hidden" id="modal-model-id" name="modelId" value="" />

      <div>
        <label for="subscribe-email" class="block text-xs font-semibold text-slate-300 mb-1.5">
          Your Email Address
        </label>
        <input
          type="email"
          id="subscribe-email"
          name="email"
          required
          placeholder="e.g. name@example.com"
          class="w-full bg-[#090A0F] border border-slate-700 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 rounded-lg px-3.5 py-2.5 text-sm text-white placeholder-slate-500 outline-none transition"
        />
      </div>

      <!-- Turnstile container (optional bot challenge) -->
      <div id="turnstile-container" class="my-2 min-h-[40px] flex justify-center"></div>

      <!-- Message Banner -->
      <div id="subscribe-message" class="text-xs p-3 rounded-lg hidden font-medium"></div>

      <!-- Submit Button -->
      <button
        type="submit"
        id="subscribe-submit-btn"
        class="w-full bg-emerald-500 hover:bg-emerald-400 text-black font-bold text-sm py-2.5 px-4 rounded-lg transition-all flex items-center justify-center gap-2 cursor-pointer shadow-lg shadow-emerald-500/20"
      >
        <span id="btn-text">Subscribe to Alerts</span>
        <span id="btn-spinner" class="hidden animate-spin">⏳</span>
      </button>

      <p class="text-[11px] text-center text-slate-500">
        🛡️ We respect your privacy. Every notification includes an instant 1-click unsubscribe link.
      </p>
    </form>
  </div>
</div>

<script>
  let currentTurnstileWidgetId: any = null;

  function initSubscribeModal() {
    const modal = document.getElementById('subscribe-modal');
    const closeBtn = document.getElementById('close-subscribe-modal');
    const form = document.getElementById('subscribe-form') as HTMLFormElement;
    const modelNameEl = document.getElementById('modal-model-name');
    const modelIdInput = document.getElementById('modal-model-id') as HTMLInputElement;
    const emailInput = document.getElementById('subscribe-email') as HTMLInputElement;
    const messageEl = document.getElementById('subscribe-message');
    const submitBtn = document.getElementById('subscribe-submit-btn') as HTMLButtonElement;
    const btnText = document.getElementById('btn-text');
    const btnSpinner = document.getElementById('btn-spinner');

    // Open modal buttons
    document.querySelectorAll('.open-subscribe-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const modelId = target.getAttribute('data-model-id') || '';
        const modelName = target.getAttribute('data-model-name') || 'Selected TV Model';

        if (modelIdInput) modelIdInput.value = modelId;
        if (modelNameEl) modelNameEl.textContent = modelName;
        if (messageEl) {
          messageEl.className = 'text-xs p-3 rounded-lg hidden font-medium';
          messageEl.textContent = '';
        }
        if (modal) modal.classList.remove('hidden');
        emailInput?.focus();
      });
    });

    // Close modal
    closeBtn?.addEventListener('click', () => {
      modal?.classList.add('hidden');
    });

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.add('hidden');
      }
    });

    // Form submission
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = emailInput.value.trim();
      const modelId = modelIdInput.value.trim();

      if (!email || !modelId) return;

      submitBtn.disabled = true;
      btnText!.textContent = 'Subscribing...';
      btnSpinner?.classList.remove('hidden');
      messageEl?.classList.add('hidden');

      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, modelId }),
        });
        const data = await res.json();

        if (res.ok && data.success) {
          messageEl!.className = 'text-xs p-3 rounded-lg font-medium bg-emerald-950/60 border border-emerald-500/40 text-emerald-300';
          messageEl!.textContent = data.message || 'Subscribed successfully!';
          form.reset();
          setTimeout(() => {
            modal?.classList.add('hidden');
          }, 2500);
        } else {
          messageEl!.className = 'text-xs p-3 rounded-lg font-medium bg-rose-950/60 border border-rose-500/40 text-rose-300';
          messageEl!.textContent = data.error || 'Failed to subscribe. Please try again.';
        }
        messageEl?.classList.remove('hidden');
      } catch (err: any) {
        messageEl!.className = 'text-xs p-3 rounded-lg font-medium bg-rose-950/60 border border-rose-500/40 text-rose-300';
        messageEl!.textContent = 'Network error. Please try again.';
        messageEl?.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        btnText!.textContent = 'Subscribe to Alerts';
        btnSpinner?.classList.add('hidden');
      }
    });
  }

  // Init on DOM ready and Astro page-load
  document.addEventListener('DOMContentLoaded', initSubscribeModal);
  document.addEventListener('astro:page-load', initSubscribeModal);
</script>
