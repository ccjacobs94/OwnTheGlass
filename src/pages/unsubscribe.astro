---
import Layout from '../layouts/Layout.astro';
import { unsubscribeEmail } from '../lib/db';

export const prerender = false;

const url = new URL(Astro.request.url);
const rawToken = url.searchParams.get('token');
const token = rawToken ? rawToken.trim() : null;
let status = url.searchParams.get('status');
let modelName = url.searchParams.get('model') || '';

// Handle direct navigation to /unsubscribe?token=xyz
if (rawToken !== null && !status) {
  if (!token) {
    status = 'missing_token';
  } else {
    const env = (Astro.locals as any).runtime?.env || {};
    const db = env.DB;
    if (!db) {
      status = 'error';
    } else {
      try {
        const result = await unsubscribeEmail(db, token);
        if (result.success) {
          status = 'success';
          if (result.modelName) modelName = result.modelName;
        } else {
          status = 'invalid_token';
        }
      } catch {
        status = 'error';
      }
    }
  }
}

if (!status) {
  status = 'missing_token';
}

if (!modelName) {
  modelName = 'your TV model';
} else if (modelName.length > 150) {
  modelName = modelName.slice(0, 150) + '…';
}

const rawMessage = url.searchParams.get('message');
let errorMessage = 'An unexpected error occurred while processing your unsubscribe request. Please try again later.';
// Only display server-issued messages. Arbitrary query text is ignored to prevent
// content-spoofing links (e.g. fake "call this number" notices on owntheglass.org).
const ALLOWED_MESSAGES = new Set([
  'Database service unavailable',
  'Unsubscribe failed. Please try again later.',
]);
if (rawMessage && ALLOWED_MESSAGES.has(rawMessage.trim())) {
  errorMessage = rawMessage.trim();
}
---

<Layout title="Unsubscribe Confirmation — OwnTheGlass">
  <div class="max-w-md mx-auto px-4 py-20 text-center">
    <div class="bg-[#121622] border border-slate-800 rounded-2xl p-8 shadow-2xl">
      {status === 'success' ? (
        <div>
          <div class="w-12 h-12 rounded-full bg-emerald-950/80 border border-emerald-500/40 text-emerald-400 flex items-center justify-center text-2xl mx-auto mb-4">
            ✓
          </div>
          <h1 class="text-xl font-bold text-white mb-2">Unsubscribed Successfully</h1>
          <p class="text-xs text-slate-400 leading-relaxed mb-6">
            You will no longer receive firmware alerts for <strong class="text-slate-200">{modelName}</strong>.
          </p>
          <a
            href="/"
            class="inline-block w-full bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-xs py-2.5 px-4 rounded-lg transition border border-slate-700"
          >
            Return to TV Catalog
          </a>
        </div>
      ) : status === 'missing_token' ? (
        <div>
          <div class="w-12 h-12 rounded-full bg-amber-950/80 border border-amber-500/40 text-amber-400 flex items-center justify-center text-2xl mx-auto mb-4">
            ⚠
          </div>
          <h1 class="text-xl font-bold text-white mb-2">Missing Unsubscribe Token</h1>
          <p class="text-xs text-slate-400 leading-relaxed mb-6">
            No unsubscribe token was found in your link. Please use the unsubscribe link provided at the bottom of your alert emails.
          </p>
          <a
            href="/"
            class="inline-block w-full bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-xs py-2.5 px-4 rounded-lg transition border border-slate-700"
          >
            Return to TV Catalog
          </a>
        </div>
      ) : status === 'invalid_token' ? (
        <div>
          <div class="w-12 h-12 rounded-full bg-rose-950/80 border border-rose-500/40 text-rose-400 flex items-center justify-center text-2xl mx-auto mb-4">
            ✕
          </div>
          <h1 class="text-xl font-bold text-white mb-2">Unsubscribe Failed</h1>
          <p class="text-xs text-slate-400 leading-relaxed mb-6">
            This unsubscribe link is invalid or has already been used.
          </p>
          <a
            href="/"
            class="inline-block w-full bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-xs py-2.5 px-4 rounded-lg transition border border-slate-700"
          >
            Return to TV Catalog
          </a>
        </div>
      ) : (
        <div>
          <div class="w-12 h-12 rounded-full bg-rose-950/80 border border-rose-500/40 text-rose-400 flex items-center justify-center text-2xl mx-auto mb-4">
            ✕
          </div>
          <h1 class="text-xl font-bold text-white mb-2">Unsubscribe Error</h1>
          <p class="text-xs text-slate-400 leading-relaxed mb-6">
            {errorMessage}
          </p>
          <a
            href="/"
            class="inline-block w-full bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-xs py-2.5 px-4 rounded-lg transition border border-slate-700"
          >
            Return to TV Catalog
          </a>
        </div>
      )}
    </div>
  </div>
</Layout>
