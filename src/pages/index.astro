---
import Layout from '../layouts/Layout.astro';
import ModelCard from '../components/ModelCard.astro';
import SubscribeModal from '../components/SubscribeModal.astro';
import AddModelModal from '../components/AddModelModal.astro';
import { getAllModels } from '../lib/db';

export const prerender = false;

const env = (Astro.locals as any).runtime?.env || {};
const db = env.DB;

let models: any[] = [];
if (db) {
  try {
    models = await getAllModels(db);
  } catch (err) {
    console.error('Failed to load models:', err);
  }
}
---

<Layout title="OwnTheGlass — Keep Your TV Private, Offline & Up to Date">
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-12 pb-16 md:pt-20 md:pb-24 border-b border-slate-800/60">
    <!-- Background Glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-emerald-500/10 blur-[120px] pointer-events-none rounded-full"></div>
    <div class="absolute top-1/3 left-1/4 w-[400px] h-[200px] bg-cyan-500/10 blur-[100px] pointer-events-none rounded-full"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-900 border border-slate-700/80 text-slate-300 text-xs font-semibold mb-6">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        <span>The Air-Gapped TV Firmware Hub</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-white max-w-4xl mx-auto leading-[1.1] mb-6">
        You paid for the panel.<br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-cyan-300 to-emerald-200">
          Own the glass.
        </span>
      </h1>

      <p class="text-base sm:text-lg text-slate-400 max-w-2xl mx-auto leading-relaxed mb-10">
        Smart TVs sweep your local network, harvest ambient audio, and push intrusive ads.
        Keep your TV <strong>100% offline</strong> while getting official firmware updates delivered to your inbox and flashed in minutes via USB.
      </p>

      <!-- Search & Filter Controls -->
      <div class="max-w-2xl mx-auto mb-8">
        <div class="relative flex items-center shadow-2xl">
          <div class="absolute left-4 text-slate-400 pointer-events-none">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input
            type="text"
            id="search-input"
            placeholder="Search by TV model (e.g. C3, C4, OLED65CX, G4)..."
            class="w-full bg-[#10141F] border border-slate-700 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/30 rounded-xl pl-12 pr-28 py-3.5 text-sm text-white placeholder-slate-500 outline-none transition"
          />
          <button
            type="button"
            id="clear-search-btn"
            class="absolute right-3 px-2.5 py-1 text-xs text-slate-400 hover:text-white bg-slate-800 rounded-md hidden cursor-pointer"
          >
            Clear
          </button>
        </div>
      </div>

      <!-- Value Pillars -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-3xl mx-auto text-left">
        <div class="bg-slate-900/50 border border-slate-800/80 rounded-xl p-3.5 flex items-start gap-3">
          <div class="text-xl">🛡️</div>
          <div>
            <div class="text-xs font-bold text-white">100% Air-Gapped</div>
            <div class="text-[11px] text-slate-400">Zero Wi-Fi or Ethernet connection needed on your display.</div>
          </div>
        </div>
        <div class="bg-slate-900/50 border border-slate-800/80 rounded-xl p-3.5 flex items-start gap-3">
          <div class="text-xl">⚡</div>
          <div>
            <div class="text-xs font-bold text-white">Official Direct CDN</div>
            <div class="text-[11px] text-slate-400">Genuine uncompressed firmware links straight from manufacturer servers.</div>
          </div>
        </div>
        <div class="bg-slate-900/50 border border-slate-800/80 rounded-xl p-3.5 flex items-start gap-3">
          <div class="text-xl">🔔</div>
          <div>
            <div class="text-xs font-bold text-white">Instant Email Alerts</div>
            <div class="text-[11px] text-slate-400">Receive an email the moment your exact TV gets an update.</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Models Catalog Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-8">
      <div>
        <h2 class="text-xl sm:text-2xl font-black text-white tracking-tight">Available TV Models</h2>
        <p class="text-xs sm:text-sm text-slate-400">Select your model to download official firmware or subscribe to update alerts.</p>
      </div>

      <!-- Quick Add Prompt -->
      <button
        type="button"
        class="open-add-model-trigger px-4 py-2 rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 hover:bg-emerald-500/20 text-xs font-bold transition flex items-center gap-2 cursor-pointer"
      >
        <span>+</span>
        <span>Don't see your TV model? Add it live</span>
      </button>
    </div>

    <!-- Models Grid -->
    <div id="models-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {models.length > 0 ? (
        models.map((model) => <ModelCard model={model} />)
      ) : (
        <div class="col-span-full py-16 text-center text-slate-500">
          <div class="text-3xl mb-2">📺</div>
          <div class="text-sm font-semibold text-slate-400">No models currently tracked.</div>
          <p class="text-xs mt-1">Click "Add TV Model" above to verify and track your first display.</p>
        </div>
      )}
    </div>

    <!-- Empty Search State (Hidden by default) -->
    <div id="no-search-results" class="hidden py-16 text-center">
      <div class="text-3xl mb-2">🔍</div>
      <h3 class="text-sm font-bold text-white mb-1">No matching TV model found</h3>
      <p class="text-xs text-slate-400 max-w-sm mx-auto mb-4">
        Your model may not be indexed yet. You can submit it to verify and add it immediately!
      </p>
      <button
        type="button"
        class="open-add-model-trigger px-4 py-2 rounded-lg bg-cyan-500 hover:bg-cyan-400 text-black text-xs font-bold transition cursor-pointer"
      >
        Verify & Add My Model Code
      </button>
    </div>
  </section>

  <!-- The Air-Gap Manifesto Section -->
  <section id="manifesto" class="border-t border-slate-800/80 bg-[#0B0E17] py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="text-xs uppercase font-bold tracking-widest text-emerald-400">The Air-Gap Philosophy</span>
        <h2 class="text-2xl sm:text-4xl font-black text-white tracking-tight mt-2 mb-4">
          Why Disconnecting Your TV Is The Best Decision You'll Make
        </h2>
        <p class="text-sm sm:text-base text-slate-400 max-w-2xl mx-auto">
          As revealed in technical security investigations by Gamers Nexus and independent researchers:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-[#121622] border border-slate-800 rounded-xl p-6">
          <div class="text-2xl mb-3">📡</div>
          <h3 class="text-base font-bold text-white mb-2">Continuous Network Scanning</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Modern smart TVs routinely probe your home network for phones, laptops, smartwatches, and NAS devices to construct a fingerprint of every person living in your home.
          </p>
        </div>

        <div class="bg-[#121622] border border-slate-800 rounded-xl p-6">
          <div class="text-2xl mb-3">🎙️</div>
          <h3 class="text-base font-bold text-white mb-2">Ambient Audio & Telemetry</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Smart TVs include far-field microphones and telemetry subsystems that analyze speech transcripts and viewing patterns—even when the screen appears powered down in standby.
          </p>
        </div>

        <div class="bg-[#121622] border border-slate-800 rounded-xl p-6">
          <div class="text-2xl mb-3">📺</div>
          <h3 class="text-base font-bold text-white mb-2">The Better Solution: Apple TV / Shield</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Connect an external dedicated media streamer (Apple TV 4K, NVIDIA Shield, or HTPC) via HDMI. Let the external box handle streaming while your TV acts purely as a gorgeous, dumb monitor.
          </p>
        </div>

        <div class="bg-[#121622] border border-slate-800 rounded-xl p-6">
          <div class="text-2xl mb-3">💾</div>
          <h3 class="text-base font-bold text-white mb-2">Zero-Compromise Firmware via USB</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            You don't lose anything by keeping Wi-Fi off. Official firmware updates can be downloaded to a USB flash drive and installed directly. You get panel optimizations and HDR patches with 100% privacy.
          </p>
        </div>
      </div>

      <div class="mt-12 text-center">
        <a
          href="/guide"
          class="inline-flex items-center gap-2 bg-emerald-500 hover:bg-emerald-400 text-black font-bold text-sm px-6 py-3 rounded-xl transition-all shadow-lg shadow-emerald-500/20"
        >
          <span>Read the Step-by-Step USB Installation Guide</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Modals -->
  <SubscribeModal />
  <AddModelModal />
</Layout>

<script>
  function initCatalogSearch() {
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const clearBtn = document.getElementById('clear-search-btn');
    const cards = document.querySelectorAll('#models-grid > [data-model-id]');
    const noResults = document.getElementById('no-search-results');
    const addModelTriggers = document.querySelectorAll('.open-add-model-trigger');
    const addModelBtn = document.getElementById('open-add-model-btn');

    addModelTriggers.forEach((btn) => {
      btn.addEventListener('click', () => {
        addModelBtn?.click();
      });
    });

    if (!searchInput) return;

    function filterCards() {
      const q = searchInput.value.trim().toLowerCase();
      let visibleCount = 0;

      if (q.length > 0) {
        clearBtn?.classList.remove('hidden');
      } else {
        clearBtn?.classList.add('hidden');
      }

      cards.forEach((card) => {
        const el = card as HTMLElement;
        const name = (el.getAttribute('data-model-name') || '').toLowerCase();
        const code = (el.getAttribute('data-model-code') || '').toLowerCase();
        const brand = (el.getAttribute('data-brand') || '').toLowerCase();

        const match = !q || name.includes(q) || code.includes(q) || brand.includes(q);
        if (match) {
          el.style.display = '';
          visibleCount++;
        } else {
          el.style.display = 'none';
        }
      });

      if (visibleCount === 0 && cards.length > 0) {
        noResults?.classList.remove('hidden');
      } else {
        noResults?.classList.add('hidden');
      }
    }

    searchInput.addEventListener('input', filterCards);
    clearBtn?.addEventListener('click', () => {
      searchInput.value = '';
      filterCards();
      searchInput.focus();
    });
  }

  document.addEventListener('DOMContentLoaded', initCatalogSearch);
  document.addEventListener('astro:page-load', initCatalogSearch);
</script>
